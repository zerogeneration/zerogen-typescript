{
  "name": "@zerogen/sdk",
  "version": "0.1.0",
  "description": "The official TypeScript library for the ZeroGen API",
  "license": "MIT",
  "author": "ZeroGen LLC",
  "homepage": "https://github.com/zerogeneration/zerogen-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerogeneration/zerogen-typescript.git"
  },
  "bugs": "https://github.com/zerogeneration/zerogen-typescript/issues",
  "keywords": [
    "zerogen",
    "generative-ai",
    "image-generation",
    "video-generation",
    "api"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "generate": "openapi-typescript openapi.json --output src/openapi.ts && biome format --write src/openapi.ts",
    "lint": "biome check .",
    "spec": "node scripts/fetch-spec.mjs && npm run generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^20.19.43",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
